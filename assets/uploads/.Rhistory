set.seed(456)
server_data <- data.frame(
timestamp = seq.POSIXt(from = as.POSIXct("2024-02-01 00:00:00"),
by = "10 min", length.out = 144),
request_rate = c(
rpois(100, lambda = 50),
rpois(44, lambda = 150)
),
memory_usage = c(
rnorm(100, mean = 60, sd = 10),
rnorm(44, mean = 85, sd = 5)
),
bandwidth = c(
rnorm(100, mean = 100, sd = 20),
rnorm(44, mean = 300, sd = 50)
)
)
ggplot(server_data, aes(x = memory_usage, y = bandwidth, color = request_rate)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, color = "black") +
labs(title = "Bandwidth vs Memory Usage",
x = "Memory Usage (%)",
y = "Bandwidth (Mbps)",
color = "Request Rate")
# Highlight memory_usage > 80
server_data$highlight <- ifelse(server_data$memory_usage > 80, "High Memory", "Normal")
ggplot(server_data, aes(x = timestamp, y = bandwidth)) +
geom_line(color = "grey") +
geom_point(aes(color = highlight), size = 2) +
geom_smooth(method = "loess", se = FALSE, color = "blue") +
scale_color_manual(values = c("High Memory" = "red", "Normal" = "black")) +
labs(title = "Bandwidth Usage Over Time",
x = "Timestamp", y = "Bandwidth (Mbps)",
color = "Memory Usage")
# Identify top 3 periods with highest bandwidth
top3 <- server_data[order(-server_data$bandwidth), ][1:3, c("timestamp", "bandwidth")]
top3
ggplot(server_data, aes(memory_usage)) +
geom_histogram(bins = 20, fill = "darkred", alpha = 0.7) +
geom_vline(aes(xintercept = mean(memory_usage)), color = "blue", lwd = 1.2) +
geom_vline(aes(xintercept = median(memory_usage)), color = "yellow", lwd = 1.2) +
labs(title = "Histogram Memory Usage",
x = "Memory Usage (%)", y = "Frequency")
ggplot(server_data, aes(x = peak_hours, y = request_rate, fill = peak_hours)) +
geom_boxplot() +
scale_fill_manual(values = c("Normal" = "green", "Peak" = "red")) +
labs(title = "Request Rate by Normal vs Peak Hours",
x = "Hour Category", y = "Request Rate")
ggplot(server_data, aes(x = peak_hours, y = request_rate, fill = peak_hours)) +
geom_boxplot() +
scale_fill_manual(values = c("Normal" = "green", "Peak" = "red")) +
labs(title = "Request Rate by Normal vs Peak Hours",
x = "Hour Category", y = "Request Rate")
ggplot(server_data, aes(x = peak_hours, y = request_rate, fill = peak_hours)) +
geom_boxplot() +
scale_fill_manual(values = c("Normal" = "green", "Peak" = "red")) +
labs(title = "Request Rate by Normal vs Peak Hours",
x = "Hour Category", y = "Request Rate")
ggplot(server_data, aes(x = peak_hours, y = request_rate, fill = peak_hours)) +
geom_boxplot() +
scale_fill_manual(values = c("Normal" = "green", "Peak" = "red")) +
labs(title = "Request Rate by Normal vs Peak Hours",
x = "Hour Category", y = "Request Rate")
library(ggplot2)
# Data sudah dibuat sesuai instruksi
set.seed(456)
server_data <- data.frame(
timestamp = seq.POSIXt(from = as.POSIXct("2024-02-01 00:00:00"),
by = "10 min", length.out = 144),
request_rate = c(
rpois(100, lambda = 50),
rpois(44, lambda = 150)
),
memory_usage = c(
rnorm(100, mean = 60, sd = 10),
rnorm(44, mean = 85, sd = 5)
),
bandwidth = c(
rnorm(100, mean = 100, sd = 20),
rnorm(44, mean = 300, sd = 50)
)
)
# Label peak / normal
server_data$peak_hours <- ifelse(server_data$request_rate > 100, "Peak", "Normal")
# =============================
# HISTOGRAM MEMORY USAGE
# =============================
ggplot(server_data, aes(memory_usage)) +
geom_histogram(bins = 20, fill = "darkred", alpha = 0.7) +
geom_vline(aes(xintercept = mean(memory_usage)), color = "blue", lwd = 1.2) +
geom_vline(aes(xintercept = median(memory_usage)), color = "yellow", lwd = 1.2) +
labs(title = "Histogram Memory Usage",
x = "Memory Usage (%)", y = "Frequency")
# =============================
# BOXPLOT REQUEST RATE BY HOURS
# =============================
ggplot(server_data, aes(x = peak_hours, y = request_rate, fill = peak_hours)) +
geom_boxplot() +
scale_fill_manual(values = c("Normal" = "green", "Peak" = "red")) +
labs(title = "Request Rate by Normal vs Peak Hours",
x = "Hour Category", y = "Request Rate")
ggplot(server_data, aes(x = memory_usage, y = bandwidth, color = request_rate)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, color = "black") +
labs(title = "Bandwidth vs Memory Usage",
x = "Memory Usage (%)",
y = "Bandwidth (Mbps)",
color = "Request Rate")
# Highlight memory_usage > 80
server_data$highlight <- ifelse(server_data$memory_usage > 80, "High Memory", "Normal")
ggplot(server_data, aes(x = timestamp, y = bandwidth)) +
geom_line(color = "grey") +
geom_point(aes(color = highlight), size = 2) +
geom_smooth(method = "loess", se = FALSE, color = "blue") +
scale_color_manual(values = c("High Memory" = "red", "Normal" = "black")) +
labs(title = "Bandwidth Usage Over Time",
x = "Timestamp", y = "Bandwidth (Mbps)",
color = "Memory Usage")
# Identify top 3 periods with highest bandwidth
top3 <- server_data[order(-server_data$bandwidth), ][1:3, c("timestamp", "bandwidth")]
top3
# =============================
# BOXPLOT REQUEST RATE BY HOURS
# =============================
ggplot(server_data, aes(x = peak_hours, y = request_rate, fill = peak_hours)) +
geom_boxplot() +
scale_fill_manual(values = c("Normal" = "green", "Peak" = "red")) +
labs(title = "Request Rate by Normal vs Peak Hours",
x = "Hour Category", y = "Request Rate")
ggplot(server_data, aes(x = memory_usage, y = bandwidth, color = request_rate)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE, color = "black") +
labs(title = "Bandwidth vs Memory Usage",
x = "Memory Usage (%)",
y = "Bandwidth (Mbps)",
color = "Request Rate")
server_data$highlight <- ifelse(server_data$memory_usage > 80, "High Memory", "Normal")
ggplot(server_data, aes(x = timestamp, y = bandwidth)) +
geom_line(color = "grey") +
geom_point(aes(color = highlight), size = 2) +
geom_smooth(method = "loess", se = FALSE, color = "blue") +
scale_color_manual(values = c("High Memory" = "red", "Normal" = "black")) +
labs(title = "Bandwidth Usage Over Time",
x = "Timestamp", y = "Bandwidth (Mbps)",
color = "Memory Usage")
