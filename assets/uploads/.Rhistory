cat("\n")
# ====================
# BAGIAN 2: PARAMETER vs STATISTIK
# ====================
# Parameter populasi (biasanya tidak diketahui dalam realitas)
pop_mean <- mean(population_response)
pop_var <- var(population_response) * (population_size - 1) / population_size  # Population variance
pop_sd <- sqrt(pop_var)
# Statistik sampel
sample_mean <- mean(sample_response)
sample_var <- var(sample_response)  # Sample variance (unbiased estimator)
sample_sd <- sd(sample_response)
# Buat tabel perbandingan
comparison_table <- data.frame(
Metric = c("Mean", "Variance", "Standard Deviation"),
Population = c(round(pop_mean, 2), round(pop_var, 2), round(pop_sd, 2)),
Sample = c(round(sample_mean, 2), round(sample_var, 2), round(sample_sd, 2)),
Difference = c(round(abs(pop_mean - sample_mean), 2),
round(abs(pop_var - sample_var), 2),
round(abs(pop_sd - sample_sd), 2))
)
print(comparison_table)
cat("\n")
# Analisis error estimasi
error_mean <- abs(pop_mean - sample_mean)
error_percentage <- (error_mean / pop_mean) * 100
cat("Error estimasi mean:", round(error_mean, 2), "ms\n")
cat("Persentase error:", round(error_percentage, 2), "%\n")
